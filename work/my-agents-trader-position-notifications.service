[Unit]
Description=My Agents Bybit position open and close notifications
After=network-online.target my-agents-trader-telegram.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/my-agents
ExecStart=/opt/my-agents/venv/bin/python /opt/my-agents/trader_position_notifications.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/my-agents

[Install]
WantedBy=multi-user.target
