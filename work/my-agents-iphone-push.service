[Unit]
Description=Bybit iPhone push notification monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/my-agents
ExecStart=/opt/my-agents/venv/bin/python /opt/my-agents/iphone_push.py
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/my-agents

[Install]
WantedBy=multi-user.target
